# Local collector secrets (never commit this file)

# Copy to ~/.config/ai-usage-dashboard/env and fill in.
# scripts/box-snapshot.sh sources it on every cron tick.
# GitHub push uses the box's existing `gh auth` (one-time: gh auth login &&
# gh auth setup-git) — no GitHub token env var here.
#
# Claude setup token may also live in ~/.claude-oauth-token; box-snapshot.sh
# exports CLAUDE_CODE_OAUTH_TOKEN from that file when the env var is empty.

OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
SAIL_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
